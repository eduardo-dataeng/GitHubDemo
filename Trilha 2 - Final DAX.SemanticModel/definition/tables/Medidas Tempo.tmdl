	measure 'Total Vendido Móvel 12M (MAT)' = ```
			
			VAR vDataContexto = MAX(dCalendario[Data])
			VAR vTotalMovel = 
			CALCULATE(
			    [Total Vendido],
			    DATESINPERIOD(
			        dCalendario[Data],
			        vDataContexto,
			        -12,
			        MONTH
			    )
			)
			RETURN
			vTotalMovel
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: c5f91073-96c0-4bad-8c34-1d77515a4aaf

