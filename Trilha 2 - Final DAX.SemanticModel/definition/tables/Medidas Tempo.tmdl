	measure 'Destaque Selecionado' =
			
			SWITCH(
			    SELECTEDVALUE(SelecaoDestaque[id]),
			    1, [Destacar Maior e Menor Valor],
			    2, [Destacar Primeiro e Último Mes v2],
			    3, [Destacar Valores Acima da Média]
			)
		lineageTag: 5105d6a6-50cf-41bf-857e-176fc8ae8921

