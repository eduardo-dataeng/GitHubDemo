		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Média Móvel Mensal 3M' = ```
			
			VAR vDataContexto = MAX(dCalendario[Data])
			VAR vTotalMovel = 
			CALCULATE(
			    [Total Vendido] / DISTINCTCOUNT(dCalendario[AnoMes]),
			    DATESINPERIOD(
			        dCalendario[Data],
			        vDataContexto,
			        -3,
			        MONTH
			    )
			)
			RETURN
			vTotalMovel
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: de2d0d10-d1ef-414e-aaa3-f864fd7fcdea

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Média Móvel Diária' = ```
			
			VAR vDataContexto = MAX(dCalendario[Data])
			VAR vTotalMovel = 
			CALCULATE(
			    [Total Vendido] / DISTINCTCOUNT(dCalendario[Data]),
			    DATESINPERIOD(
			        dCalendario[Data],
			        vDataContexto,
			        -[NMeses Valor],
			        MONTH
			    )
			)
			RETURN
			vTotalMovel
			```
		lineageTag: 4b63dc98-3311-4d0c-aa37-4354b870a64e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Destacar Maior e Menor Valor' =
			
			VAR vMaiorValorMensal =
			MAXX( ALLSELECTED(dCalendario[Ano], dCalendario[Mês Abrev.], dCalendario[Mês]), [Total Vendido] )
			VAR vMaiorValorDiario =
			MAXX( ALLSELECTED(dCalendario), [Total Vendido] )
			VAR vMenorValorMensal =
			MINX( ALLSELECTED(dCalendario[Ano], dCalendario[Mês Abrev.], dCalendario[Mês]), [Total Vendido] )
			VAR vMenorValorDiario =
			MINX( ALLSELECTED(dCalendario), [Total Vendido] )
			RETURN
			SWITCH(
			    TRUE(),
			    ISINSCOPE(dCalendario[Dia]) && [Total Vendido] = vMaiorValorDiario, "cyan",
			    NOT(ISINSCOPE(dCalendario[Dia])) && [Total Vendido] = vMaiorValorMensal, "cyan",
			    ISINSCOPE(dCalendario[Dia]) && [Total Vendido] = vMenorValorDiario, "red",
			    NOT(ISINSCOPE(dCalendario[Dia])) && [Total Vendido] = vMenorValorMensal, "red"
			)
		lineageTag: 951bda2a-ab78-4617-abce-d8e54d0b8883

		annotation PBI_FormatHint = {"isText":true}

	measure 'Destacar Primeiro e Último Mes v1' = ```
			
			VAR vPrimeiroMes = CALCULATE( MIN(dCalendario[Contador MesAno]), ALLSELECTED(dCalendario) )
			VAR vUltimoMes = 
			CALCULATE( 
			    MAX(dCalendario[Contador MesAno]), 
			    FILTER(
			        ALLSELECTED(dCalendario),
			        NOT(ISBLANK([Total Vendido]))
			    )
			)
			VAR vTotalPrimeiroMes = CALCULATE([Total Vendido], dCalendario[Contador MesAno] = vPrimeiroMes)
			VAR vTotalUltimoMes = CALCULATE([Total Vendido], dCalendario[Contador MesAno] = vUltimoMes)
			RETURN
			SWITCH(
			    TRUE(),
			    MAX(dCalendario[Contador MesAno]) = vPrimeiroMes, vTotalPrimeiroMes,
			    MAX(dCalendario[Contador MesAno]) = vUltimoMes, vTotalUltimoMes
			)
			```
		formatString: 0
		lineageTag: 90f882a3-f0b2-4f19-a66a-40c3bb67c8da

	measure 'Destacar Primeiro e Último Mes v2' = ```
			
			VAR vPrimeiroMes = CALCULATE( MIN(dCalendario[Contador MesAno]), ALLSELECTED(dCalendario) )
			VAR vUltimoMes = 
			CALCULATE( 
			    MAX(dCalendario[Contador MesAno]), 
			    FILTER(
			        ALLSELECTED(dCalendario),
			        NOT(ISBLANK([Total Vendido]))
			    )
			)
			RETURN
			SWITCH(
			    TRUE(),
			    MAX(dCalendario[Contador MesAno]) = vPrimeiroMes, "red",
			    MAX(dCalendario[Contador MesAno]) = vUltimoMes, "blue"
			)
			```
		lineageTag: e762d5fa-f5b6-408a-a397-44a7edcf7ac6

		annotation PBI_FormatHint = {"isText":true}

	measure 'Destacar Valores Acima da Média' =
			
			VAR vMediaMensal =
			AVERAGEX( ALLSELECTED(dCalendario[Ano], dCalendario[Mês Abrev.], dCalendario[Mês]), [Total Vendido] )
			VAR vMediaDiario =
			AVERAGEX( ALLSELECTED(dCalendario), [Total Vendido] )
			RETURN
			SWITCH(
			    TRUE(),
			    ISINSCOPE(dCalendario[Dia]) && [Total Vendido] >= vMediaDiario, "blue",
			    NOT(ISINSCOPE(dCalendario[Dia])) && [Total Vendido] >= vMediaMensal, "red"
			)
		lineageTag: d146cacb-de66-4d70-8bd2-86af3fba7eee

		annotation PBI_FormatHint = {"isText":true}

	measure 'Valor de Referência' = [Parâmetro Valor] * 2000000
