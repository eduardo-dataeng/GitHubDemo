	measure 'Total Vendido PY raiz' =
			
			VAR vAnoContexto = SELECTEDVALUE(dCalendario[Ano])
			RETURN
			CALCULATE(
			    [Total Vendido],
			    ALL(dCalendario),
			    dCalendario[Ano] = vAnoContexto - 1
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 4db19bc5-cb43-4839-b3df-338bc5098d8f

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Vendido LY raiz' =
			
			VAR vAnoContexto = MAX(dCalendario[Ano])
			VAR vUltimaDataFato = CALCULATE( MAX(fVendas[Data Venda]), ALL(fVendas) )
			VAR vUltimaDataAnoAnterior = EDATE(vUltimaDataFato, -12)
			VAR vResultado =
			CALCULATE(
			    [Total Vendido],
			    dCalendario[Ano] = vAnoContexto - 1,
			    KEEPFILTERS( dCalendario[Data] <= vUltimaDataAnoAnterior )
			)
			RETURN
			vResultado
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: c030958b-9417-4ffa-88d4-25ab04fe0246

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Vendido LY raiz v2' =
			
			VAR vAnoContexto = MAX(dCalendario[Ano])
			VAR vUltimaDataFato = CALCULATE( MAX(fVendas[Data Venda]), ALL(fVendas) )
			VAR vUltimaDataAnoAnterior = EDATE(vUltimaDataFato, -12)
			VAR vResultado =
			CALCULATE(
			    [Total Vendido],
			    FILTER(
			        ALL(dCalendario),
			        dCalendario[Ano] = vAnoContexto - 1 &&
			        dCalendario[Data] <= vUltimaDataAnoAnterior
			    ),
			    VALUES(dCalendario[Mês])
			)
			RETURN
			vResultado
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 7ca57a8e-261b-4c92-aae9-c8a5c6e2171b

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Vendido LM raiz' = ```
			
			VAR vMes = MAX(dCalendario[Contador MesAno])
			VAR vLM = 
			CALCULATE(
			    [Total Vendido],
			    ALL(dCalendario[Nome do Mês], dCalendario[Mês], dCalendario[Ano]),
			    dCalendario[Contador MesAno] = vMes - 1
			)
			RETURN
			vLM
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 3f168fe3-11a6-43dc-a616-b0a8a56a308b

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Vendido RT' = ```
			
			VAR vRT = 
			CALCULATE(
			    [Total Vendido],
			    CALCULATETABLE(
			        FILTER(
			            ALLSELECTED(dCalendario),
			            dCalendario[Data] <= MAX(dCalendario[Data])
			        ),
			        dCalendario[PossuiDados] = TRUE()
			    )
			)
			RETURN
			vRT
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
