	measure 'Total Vendido LYTD' =
			
			CALCULATE(
			    [Total Vendido],
			    DATESYTD(SAMEPERIODLASTYEAR(dCalendario[Data]))
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
