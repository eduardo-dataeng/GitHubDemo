table 'Medidas Tempo'
	lineageTag: be692180-e264-4484-8544-8343169a9f0d

	measure 'Total Vendido LY' =
			
			CALCULATE(
			    [Total Vendido],
			    CALCULATETABLE(
			        SAMEPERIODLASTYEAR(dCalendario[Data]),
			        dCalendario[PossuiDados] = TRUE()
			    )
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 1116cd37-a0b6-4ea0-a900-eefced58c66a

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Vendido PY' =
			
			CALCULATE(
			    [Total Vendido],
			    PREVIOUSYEAR(dCalendario[Data])
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 4c3308d2-3616-4a40-b17a-59f540c43d70

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% YoY' =
			
			VAR vLY = [Total Vendido LY]
			VAR vVariacao = [Total Vendido] - vLY
			VAR vPercent = DIVIDE(vVariacao, vLY)
			RETURN
			vPercent
		formatString: 0%;-0%;0%
		lineageTag: 247f8edb-9178-468e-ad5b-427e9bd2f264

		changedProperty = FormatString

	measure 'Total Vendido LM' =
			
			CALCULATE(
			    [Total Vendido],
			    DATEADD(dCalendario[Data], -1, MONTH)
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 75290397-85ff-4d69-9490-b2d726a3e772

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Vendido PM' =
			
			CALCULATE(
			    [Total Vendido],
			    PREVIOUSMONTH(dCalendario[Data])
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 428aad88-f231-4a1b-b5e4-4b946d5115c8

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% MoM' =
			
			VAR vLM = [Total Vendido LM]
			VAR vVar = [Total Vendido] - vLM
			VAR vPerc = DIVIDE(vVar, vLM)
			RETURN
