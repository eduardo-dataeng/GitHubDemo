table 'Medidas Gerais'
	lineageTag: c0cc9c75-fbdb-41bf-87f5-2fa3b3b45cb5

	measure 'Total Vendido' = ```
			
			// SUMX(
			//     fVendas, 
			//     fVendas[Preço Unitário] * fVendas[Quantidade] - fVendas[Valor Desconto]
			// )
			SUM(fVendas[Valor Venda])
			```
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: ca4ad349-2ea7-4798-831a-8c43bd769df2

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Desconto' = SUM(fVendas[Valor Desconto])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: ab421cc6-3880-43f6-8186-084c00218f3e

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Desconto' =
			
			DIVIDE(
			    [Total Desconto],
			    SUMX(fVendas, fVendas[Preço Unitário] * fVendas[Quantidade])
			    //[Total Vendido] + [Total Desconto]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d6a4c8e5-12ed-418e-82e4-9965897dd1fe

		changedProperty = FormatString

	measure 'Total Custo' = SUM(fVendas[Custo Venda])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: c32e1b85-26c8-474d-9b0b-5623ac532572

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Lucro' = [Total Vendido] - [Total Custo]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 71d5f30f-cd74-469e-9a0b-0f5886ac7b32

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Margem' = DIVIDE([Total Lucro], [Total Vendido])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 47fade8e-220c-4547-8b0b-3eee6bf57e72

		changedProperty = FormatString

	measure 'Notas Emitidas' = DISTINCTCOUNT(fVendas[No. Venda])
		formatString: #,0
		lineageTag: 6505cc0a-3c87-4199-a326-1f466f163507

		changedProperty = FormatString

	measure 'SKUs Vendidos' = DISTINCTCOUNT(fVendas[ID Produto])
		formatString: 0
		lineageTag: b08c0b9e-2e02-4f5e-b218-b6d5a127dda2

	measure 'Cobertura Clientes' = DISTINCTCOUNT(fVendas[ID Cliente])
		formatString: #,0
		lineageTag: fa0d3b57-a9aa-4804-8127-2f1afdb32b25

