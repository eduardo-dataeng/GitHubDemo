	measure 'Qtd Linhas Vendas' = COUNTROWS(fVendas)
		formatString: #,0
		lineageTag: 8cd1e77b-59dd-4faa-a27c-96834a6da4fc

		changedProperty = FormatString

	measure 'Segmento Produto Medida' = ```
			IF( [Total Vendido] > 1000000, "Gold", "Silver" ) 
			```
		lineageTag: cf111801-e712-4a90-b7e9-60d6b17df983

		annotation PBI_FormatHint = {"isText":true}

	measure 'Classe Cliente Medida' =
			
			SWITCH(
			    TRUE(),
			    [Total Vendido] >= 1000000 && [% Margem] >= 0.5, "Platinum",
			    [Total Vendido] >= 1000000 && [% Margem] < 0.5, "Premium",
			    [Total Vendido] >= 500000 && [% Margem] >= 0.5, "Gold",
			    [Total Vendido] >= 500000 && [% Margem] < 0.5, "Silver",
			    [Total Vendido] > 0, "Bronze",
			    [Total Vendido] = 0, "New",
			    "ERRO DE CONFIGURAÇÃO"
			)
		lineageTag: 2ba3c407-f350-4769-9549-ba143c3aae84

		annotation PBI_FormatHint = {"isText":true}

	measure 'Carteira Clientes' = COUNTROWS(dCliente)
		formatString: #,0
		lineageTag: 1cb33d45-5652-4237-abbf-d5f324666fec

		changedProperty = FormatString

	measure 'KPI Emoji Produto' = IF( [Total Vendido] > 1000000, "🏆", "🥈" )
		lineageTag: e5708fc8-62d4-48a2-9171-563d360faf29

		annotation PBI_FormatHint = {"isText":true}

	measure 'KPI Gif Produto' = ```
			
			IF( 
			    [Total Vendido] > 1000000,
			    "https://media.giphy.com/media/wb6xgCSpLl0m4/giphy.gif", 
			    "https://media.giphy.com/media/L1QMTl9ggmYGoCu7oj/giphy.gif" 
			)
			```
		lineageTag: 4152a52b-4f6d-4b05-87ba-4c31563c504b
